# Copy to .env and fill in. Never commit .env.

TZ=America/New_York

# Publish the dashboard ports only on this address (the Unraid LAN IP). 0.0.0.0 = every interface.
BIND_IP=192.168.1.20

# OPNsense LAPI - use the LAN address you set as the plugin's LAPI listen address
LAPI_URL=http://192.168.1.1:8080

# Machine the dashboard logs in as  (cscli machines add crowdsec-dash --password ... -f /dev/null)
DASH_MACHINE_ID=crowdsec-dash
DASH_MACHINE_PASSWORD=change-me

# Machine the Unraid CrowdSec agent logs in as  (cscli machines add unraid-npm --password ... -f /dev/null)
AGENT_MACHINE_ID=unraid-npm
AGENT_MACHINE_PASSWORD=change-me-too

# Where NPM writes proxy-host-*_access.log on the Unraid host. Common locations:
#   official image  (jc21/nginx-proxy-manager):  /mnt/user/appdata/<npm-folder>/data/logs
#   jlesage image   (jlesage/nginx-proxy-manager): /mnt/user/appdata/NginxProxyManager/log
NPM_LOGS=/mnt/user/appdata/NginxProxyManager/log

# Only accept firewall syslog from these senders (comma separated IPs/CIDRs). Empty = anyone
# on the network can feed fake events in, so set this to your OPNsense address.
SYSLOG_ALLOWED_SOURCES=192.168.1.1

# Only keep firewall drops from these interfaces (comma separated). Empty = all.
# Your WAN NIC name is on OPNsense under Interfaces > Overview (e.g. igb0, vtnet0, pppoe0).
FW_INTERFACES=

# Optional: Cloudflare API token with Zone:Read + DNS:Read (+ Analytics:Read for events)
CF_API_TOKEN=
CF_FETCH_EVENTS=false

# Dashboard login. Required: with no password the dashboard refuses every request
# unless you explicitly set ALLOW_NO_AUTH=true.
DASH_USER=admin
DASH_PASSWORD=
ALLOW_NO_AUTH=false

# Host names you open the dashboard by, besides IP addresses (which always work), e.g.
# "unraid.lan,dash.example.com". Requests for any other name are refused (DNS-rebinding protection).
ALLOWED_HOSTS=

# Show Ban / Unban buttons (the dashboard machine can then add/delete decisions)
ALLOW_WRITE=false

# User/group the dashboard runs as inside the container (99:100 = Unraid nobody:users).
# It must be able to read the NPM log files. PUID=0 runs it as root.
PUID=99
PGID=100

RETENTION_DAYS=14

# --- Optional: also block banned IPs inside Nginx Proxy Manager (SETUP.md step 9) ---
# Covers Cloudflare-proxied hosts, which the firewall can't. Uncomment the first line to enable.
#COMPOSE_PROFILES=npm-bouncer
# NPM's container name, as shown by `docker ps`
NPM_CONTAINER=Nginx-Proxy-Manager-Official
# The host folder NPM mounts at /data
NPM_DATA=/mnt/user/appdata/Nginx-Proxy-Manager-Official/data
# From `cscli bouncers add npm-bouncer` on OPNsense
NPM_BOUNCER_API_KEY=
# Whose bans to apply: crowdsec,cscli = your agents + manual bans. Add lists (blocklists you
# subscribed to in the CrowdSec Console) and CAPI (the community blocklist), or use "all".
NPM_BOUNCER_ORIGINS=crowdsec,cscli
