# Copy to .env and fill in. Never commit .env.

TZ=America/New_York

# OPNsense LAPI - use the LAN address you set as the plugin's LAPI listen address
LAPI_URL=http://192.168.1.1:8080

# Machine the dashboard logs in as  (cscli machines add crowdsec-dash --password ... -f /dev/null)
DASH_MACHINE_ID=crowdsec-dash
DASH_MACHINE_PASSWORD=change-me

# Machine the Unraid CrowdSec agent logs in as  (cscli machines add unraid-npm --password ... -f /dev/null)
AGENT_MACHINE_ID=unraid-npm
AGENT_MACHINE_PASSWORD=change-me-too

# Where NPM writes proxy-host-*_access.log on the Unraid host. Common locations:
#   official image  (jc21/nginx-proxy-manager):  /mnt/user/appdata/<npm-folder>/data/logs
#   jlesage image   (jlesage/nginx-proxy-manager): /mnt/user/appdata/NginxProxyManager/log
NPM_LOGS=/mnt/user/appdata/NginxProxyManager/log

# Only keep firewall drops from these interfaces (comma separated). Empty = all.
# Your WAN NIC name is on OPNsense under Interfaces > Overview (e.g. igb0, vtnet0, pppoe0).
FW_INTERFACES=

# Optional: Cloudflare API token with Zone:Read + DNS:Read (+ Analytics:Read for events)
CF_API_TOKEN=
CF_FETCH_EVENTS=false

# Optional: password-protect the dashboard (recommended if anyone else is on your LAN)
DASH_USER=admin
DASH_PASSWORD=

# Show Ban / Unban buttons (the dashboard machine can then add/delete decisions)
ALLOW_WRITE=false

RETENTION_DAYS=14
